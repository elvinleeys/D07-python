# 이 파일을 복사해서 .env 파일을 만들고, OPENWEATHER_API_KEY에 발급받은 API 키를 입력하세요.
# 발급: https://openweathermap.org/
OPENWEATHER_API_KEY=발급받은 API 키

# rateCalc.py 용 ExchangeRate API 키
# 발급: https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=발급받은 API 키

# chat.py 용 OpenAI API 키
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=발급받은 API 키